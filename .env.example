PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
APP_PASSWORD_HASH=replace-with-the-hash-from-scripts/set-password.js

# --- Due Today tab (reads/writes Daily Planner's Tasks panel) ---
# Container name + internal port on the shared apps-net network —
# not the host-mapped port (e.g. http://daily-planner:3000, not 127.0.0.1:3050)
DAILY_PLANNER_API_URL=http://daily-planner:3000
# Must match DASHBOARD_API_KEY set in Daily Planner's own .env
DAILY_PLANNER_API_KEY=
